# This code calculates the percentage change in population for a list of countries from 2020 to 2024, identifies the countries with the highest increase and decrease in population, and visualizes the changes using a bar chart.
import matplotlib.pyplot as plt
pop_data={'UK': (66.7, 69.2), 'China': (1426, 1410), 'Italy': (59.4, 58.9), 'Brazil': (208.6, 212.0), 'USA': (331.6, 304.1)} # Initializing a dictionary with country names as keys and tuples containing population data (current and previous) as values
percent_changes={}  # Initializing an empty dictionary to store the percentage changes in population for each country
for country, (pop2020, pop2024) in pop_data.items():  # Iterating through each country and its corresponding population data in the dictionary
   percent_change=((pop2024-pop2020)/pop2020)*100  # Calculating the percentage change in population using the formula: ((current - previous) / previous) * 100
   percent_changes[country]=percent_change  # Storing the calculated percentage change in the 'percent_changes' dictionary with the country as the key
print("Percentage changes in population from 2020 to 2024:")  # Printing a header for the output
for country, change in percent_changes.items():  # Iterating through each country and its corresponding
    print(f"{country}: {change:.2f}%")  # Printing the country name and its percentage change formatted to two decimal places
countries=list(percent_changes.keys())  # Extracting the country names from the 'percent_changes' dictionary to use as labels for the bar chart
max_increase_country=countries[0]  # Initializing a variable to keep track of the country with the maximum population increase, starting with the first country in the list
max_decrease_country=countries[0]  # Initializing a variable to keep track of the country with the maximum population decrease, starting with the first country in the list
for country in countries:  # Iterating through each country in the list of countries
    if percent_changes[country]>percent_changes[max_increase_country]:  # Checking if the percentage change for the current country is greater than the current maximum increase
        max_increase_country=country  # Updating the max_increase_country variable to the current country if it has a higher percentage increase
    if percent_changes[country]<percent_changes[max_decrease_country]:  # Checking if the percentage change for the current country is less than the current maximum decrease
        max_decrease_country=country  # Updating the max_decrease_country variable to the current country if it has a higher percentage decrease
print(f"Country with the highest population increase: {max_increase_country} ({percent_changes[max_increase_country]:.2f}%)")  # Printing the country with the highest population increase and its percentage change
print(f"Country with the highest population decrease: {max_decrease_country} ({percent_changes[max_decrease_country]:.2f}%)")  # Printing the country with the highest population decrease and its percentage change
items=[]  # Initializing an empty list to store the items for the bar chart
for country in countries:  # Iterating through each country in the list of countries
    items.append((country, percent_changes[country]))  # Appending a tuple of the country name and its percentage change to the 'items' list
n=len(items)  # Calculating the number of items in the 'items' list to determine the number of bars in the chart
for i in range(n):  # Iterating through the range of the number of items to create bars for each country
    max_index=i  # Initializing a variable to keep track of the index of the maximum percentage change for the current iteration
    for j in range(i+1, n):  # Iterating through the remaining items to find the maximum percentage change
        if items[j][1]>items[max_index][1]:  # Checking if the percentage change at index j is greater than the current maximum percentage change
            max_index=j  # Updating the max_index variable to j if it has a higher percentage change
    items[i], items[max_index]=items[max_index], items[i]  # Swapping the current item with the item at max_index to sort the list in descending order
print("Percentage changes in descending order:")  # Printing a header for the output
for country, change in items:  # Iterating through the sorted list of items to print the country names and their percentage changes
    print(f"{country}: {change:.2f}%")  # Printing the country name and its percentage change formatted to two decimal places
countries_sorted=[]  # Initializing an empty list to store the sorted country names for the bar chart
changes_sorted=[]  # Initializing an empty list to store the sorted percentage changes for the bar chart
colors=[]  # Initializing an empty list to store the colors for the bars in the chart
for country, change in items:  # Iterating through the sorted list of items to populate the lists for the bar chart
    countries_sorted.append(country)  # Appending the country name to the 'countries_sorted' list
    changes_sorted.append(change)  # Appending the percentage change to the 'changes_sorted' list
    if change>0:  # Checking if the percentage change is positive
        colors.append('lightgreen')  # Adding 'lightgreen' to the colors list for positive changes
    else:  # If the percentage change is not positive (i.e., negative)
        colors.append('lightcoral')  # Adding 'lightcoral' to the colors list for negative changes
plt.figure(figsize=(10,6))  # Setting the figure size for the bar chart
plt.bar(countries_sorted, changes_sorted, color=colors)  # Creating a bar chart with the sorted country names, percentage changes, and corresponding colors 
plt.xlabel('Countries')  # Setting the label for the x-axis
plt.ylabel('Percentage Change in Population')  # Setting the label for the y-axis
plt.title('Percentage Change in Population from 2020 to 2024')  # Setting the title for the bar chart
plt.axhline(0, color='black', linewidth=0.8)  # Adding a horizontal line at y=0 to distinguish between positive and negative changes
plt.show()  # Displaying the bar chart